@{
    ViewData["Title"] = "Subscription";
}

<div class="subscription-page">

    <div class="container">

        <div class="text-center mb-5">
            <p class="section-label">HEMPACT PLAN</p>

            <h1 class="hero-title mb-3">
                Create your personal care plan.
            </h1>

            <p class="hero-subtitle">
                Choose your preferred Hempact routine and start your sustainable period care journey.
            </p>
        </div>

        <div class="subscription-card mx-auto">

            <form asp-controller="Home"
                  asp-action="AddSubscription"
                  method="post">

                <div class="mb-4">
                    <label class="contact-label">Full Name</label>
                    <input name="fullName"
                           class="contact-input"
                           placeholder="Enter your name"
                           required />
                </div>

                <div class="mb-4">
                    <label class="contact-label">Email Address</label>
                    <input name="email"
                           type="email"
                           class="contact-input"
                           placeholder="Enter your email"
                           required />
                </div>

                <div class="mb-4">
                    <label class="contact-label">Select Plan</label>

                    <select name="planType"
                            class="contact-input"
                            required>
                        <option value="Basic Plan">Basic Plan</option>
                        <option value="Essential Plan">Essential Plan</option>
                        <option value="Premium Plan">Premium Plan</option>
                    </select>
                </div>

                <button type="submit" class="contact-btn">
                    Submit Subscription
                </button>

            </form>

        </div>

    </div>

</div>