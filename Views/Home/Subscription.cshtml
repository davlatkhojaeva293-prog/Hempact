@{
    ViewData["Title"] = "Subscription";
}

<div class="subscription-page">
    <div class="container">

        <div class="text-center mb-5">
            <p class="section-label">SUBSCRIPTION</p>

            <h1 class="products-title">
                Your cycle, on auto-pilot.
            </h1>

            <p class="text-muted fs-5">
                Pick a plan, set your delivery rhythm. Pause, skip or change anytime.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="subscription-card">
                    <h3 class="subscription-plan-name">Lite</h3>
                    <p class="subscription-price">$14 <span>per cycle</span></p>

                    <p class="subscription-feature">✓ 1 box of pads</p>
                    <p class="subscription-feature">✓ Free shipping</p>
                    <p class="subscription-feature">✓ Pause anytime</p>

                    <button type="button"
                            class="subscription-btn-outline"
                            onclick="showPlanDetails('Lite', 'Lite plan includes 1 box of pads, free shipping and flexible pause option.')">
                        Choose Lite
                    </button>
                </div>
            </div>

            <div class="col-md-4">
                <div class="subscription-card featured-plan">
                    <p class="most-loved">MOST LOVED</p>

                    <h3 class="subscription-plan-name">Essential</h3>
                    <p class="subscription-price">$24 <span>per cycle</span></p>

                    <p class="subscription-feature">✓ 2 boxes, your choice</p>
                    <p class="subscription-feature">✓ Free shipping</p>
                    <p class="subscription-feature">✓ 10% off add-ons</p>
                    <p class="subscription-feature">✓ Pause anytime</p>

                    <button type="button"
                            class="subscription-btn-filled"
                            onclick="showPlanDetails('Essential', 'Essential plan includes 2 boxes of your choice, free shipping, 10% off add-ons and pause anytime.')">
                        Choose Essential
                    </button>
                </div>
            </div>

            <div class="col-md-4">
                <div class="subscription-card">
                    <h3 class="subscription-plan-name">Complete</h3>
                    <p class="subscription-price">$38 <span>per cycle</span></p>

                    <p class="subscription-feature">✓ 3 boxes + 1 surprise care item</p>
                    <p class="subscription-feature">✓ Free shipping</p>
                    <p class="subscription-feature">✓ 15% off everything</p>
                    <p class="subscription-feature">✓ Priority support</p>

                    <button type="button"
                            class="subscription-btn-outline"
                            onclick="showPlanDetails('Complete', 'Complete plan includes 3 boxes, 1 surprise care item, free shipping, 15% off everything and priority support.')">
                        Choose Complete
                    </button>
                </div>
            </div>

        </div>

      

<script>
    function showPlanDetails(planName, description) {
        document.getElementById("planType").value = planName;

        document.querySelector(".subscription-form-card").scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }
</script>

<div class="subscription-form-card mt-5">

        <div class="subscription-form-card mt-5">
            <h3 class="subscription-form-title">
                Start Your Subscription
            </h3>

            <p class="text-muted mb-4">
                Tell us a little about yourself and we'll prepare your Hempact plan.
            </p>

            <form asp-controller="Home"
                  asp-action="AddSubscription"
                  method="post">

                <div class="mb-4">
                    <label class="contact-label">Full Name</label>
                    <input name="fullName"
                           type="text"
                           class="contact-input"
                           placeholder="Enter your name"
                           required />
                </div>

                <div class="mb-4">
                    <label class="contact-label">Email Address</label>
                    <input name="email"
                           type="email"
                           class="contact-input"
                           placeholder="Enter your email"
                           required />
                </div>

                <div class="mb-4">
                    <label class="contact-label">Select Plan</label>

                    <select name="planType"
                            id="planType"
                            class="contact-input"
                            required>
                        <option value="Lite">Lite</option>
                        <option value="Essential">Essential</option>
                        <option value="Complete">Complete</option>
                    </select>
                </div>

                <button type="submit" class="contact-btn">
                    Submit Subscription
                </button>

            </form>
        </div>

    </div>
</div>

<script>
    function showPlanDetails(planName, description) {
        document.getElementById("planType").value = planName;
        document.getElementById("selectedPlanTitle").innerText = planName + " Plan";
        document.getElementById("selectedPlanDescription").innerText = description;

        document.getElementById("selectedPlanBox").classList.remove("d-none");

        document.getElementById("selectedPlanBox").scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }

    function goToSubscriptionForm() {
        document.querySelector(".subscription-form-card").scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }
</script>