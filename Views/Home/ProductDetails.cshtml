@model Hempact.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="product-details-page">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6 text-center">

                @{
    var images = new List<string>();

    if (Model.Name == "Organic Super Pad")
    {
        images = new List<string>
        {
            "/images/products/superpad1.jpg",
            "/images/products/superpad2.webp",
            "/images/products/superpad3.webp"
        };
    }
    else if (Model.Name?.Contains("Regular") == true)
    {
        images = new List<string>
        {
            "/images/products/regularpad1.webp",
            "/images/products/regularpad2.webp",
            "/images/products/regularpad3.webp"
        };
    }
    else if (Model.Name == "Organic Liners")
    {
        images = new List<string>
        {
            "/images/products/liners1.webp",
            "/images/products/liners2.webp",
            "/images/products/liners3.webp"
        };
    }
    else if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        images = new List<string> { Model.ImageUrl };
    }
}

@if (images.Count > 0)
{
    <div id="productDetailsCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">

            @for (int i = 0; i < images.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@images[i]"
                         class="product-detail-img"
                         alt="@Model.Name" />
                </div>
            }

        </div>

        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#productDetailsCarousel"
                data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#productDetailsCarousel"
                data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
}
else
{
    <div class="product-detail-placeholder">
        No Image Available
    </div>
}

            </div>

            <div class="col-lg-6">

                <p class="section-label">
                    HEMPACT PRODUCT
                </p>

                <h1 class="product-detail-title">
                    @Model.Name
                </h1>

                <p class="product-detail-description">
                    @Model.Description
                </p>

                <p class="product-detail-price">
                    $@Model.Price
                </p>

                @if (Model.Stock > 0)
                {
                    <p class="stock-text">
                        In stock: @Model.Stock
                    </p>
                }
                else
                {
                    <p class="text-danger">
                        Out of stock
                    </p>
                }

                <div class="mt-4 d-flex gap-3 flex-wrap">

                    <a asp-controller="Home"
                       asp-action="AddToCart"
                       asp-route-id="@Model.Id"
                       class="hero-primary-btn">
                        Add To Cart
                    </a>

                    <a asp-controller="Home"
                       asp-action="Products"
                       class="hero-secondary-btn">
                        Back To Products
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>