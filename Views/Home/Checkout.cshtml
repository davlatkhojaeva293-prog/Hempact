@{
    ViewData["Title"] = "Checkout";
}

<div class="checkout-page">
    <div class="container">

    <div class="text-center mb-5">
        <<p class="section-label">
    SECURE CHECKOUT
</p>

<h1 class="products-title">
    Complete your order.
</h1>

<p class="text-muted fs-5">
    Review your information and complete your Hempact purchase.
</p>
    </div>

    <form asp-controller="Home" asp-action="CreateOrder" method="post">

        <div class="row">

            <div class="col-lg-7">

                <div class="checkout-section">
                    <h2 class="checkout-section-title">Contact</h2>

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input name="customerName" class="form-control" placeholder="Enter your full name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input name="email" type="email" class="form-control" placeholder="Enter your email" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input class="form-control" placeholder="Delivery address" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">City</label>
                            <input class="form-control" placeholder="City" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Country</label>
                            <input class="form-control" placeholder="Country" />
                        </div>
                    </div>
                </div>

               <div class="checkout-section mt-5">
                    <h2 class="checkout-section-title">Payment</h2>

                    <div class="mb-3">
                        <label class="form-label">Card Number</label>
                        <input class="form-control" placeholder="0000 0000 0000 0000" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Expiry Date</label>
                            <input class="form-control" placeholder="MM/YY" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">CVV</label>
                            <input class="form-control" placeholder="123" />
                        </div>
                    </div>

                    <p class="text-muted small mb-0">
                        This is a payment simulation for academic project purposes. No real payment is processed.
                    </p>
                </div>

            </div>

            <div class="col-lg-5 mt-4 mt-lg-0">

                <div class="checkout-summary">
                    <h4 class="fw-bold mb-4">Order Summary</h4>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Subtotal</span>
                        <strong>$@ViewBag.TotalAmount</strong>
                    </div>  

                    <div class="d-flex justify-content-between mb-3">
                        <span>Shipping</span>
                        <strong>Free</strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold">Total</span>
                        <strong class="text-success fs-4">$@ViewBag.TotalAmount</strong>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100">
                        Complete Payment
                    </button>

                    <a asp-controller="Home"
                       asp-action="Cart"
                       class="btn btn-outline-secondary w-100 mt-3">
                        Back to Cart
                    </a>
                </div>

            </div>

        </div>

    </form>

</div>
</div>