@{
    ViewData["Title"] = "Register";
}

<div class="container" style="padding-top:120px; padding-bottom:100px;">

    <div class="text-center mb-5">
        <h1 class="hero-title mb-3">
            Create Your Account
        </h1>

        <p class="hero-subtitle">
            Join Hempact and start your sustainable care journey.
        </p>
    </div>

    <div class="login-card mx-auto">

        <div class="mb-4">
            <label class="contact-label">
                Full Name
            </label>

            <input type="text"
                   class="contact-input"
                   placeholder="Enter your full name" />
        </div>

        <div class="mb-4">
            <label class="contact-label">
                Email Address
            </label>

            <input type="email"
                   class="contact-input"
                   placeholder="Enter your email" />
        </div>

        <div class="mb-4">
            <label class="contact-label">
                Password
            </label>

            <input type="password"
                   class="contact-input"
                   placeholder="Create a password" />
        </div>

        <div class="mb-4">
            <label class="contact-label">
                Confirm Password
            </label>

            <input type="password"
                   class="contact-input"
                   placeholder="Confirm your password" />
        </div>

        <a asp-controller="Home"
           asp-action="Login"
           class="login-btn">
            Create Account
        </a>

        <p class="text-center mt-4 mb-0">
            Already have an account?
            <a asp-controller="Home"
               asp-action="Login"
               class="register-link">
                Sign In
            </a>
        </p>

    </div>

</div>