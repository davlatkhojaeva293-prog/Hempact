@model Hempact.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Edit Product</h1>

    <div class="card p-4 mx-auto" style="max-width: 600px;">
        <form asp-controller="Home" asp-action="EditProduct" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label>Product Name</label>
                <input asp-for="Name" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Price</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Description</label>
                <input asp-for="Description" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Stock</label>
                <input asp-for="Stock" type="number" class="form-control" />
            </div>
            <div class="mb-3">
    <label>Image URL</label>
<input asp-for="ImageUrl"
       class="form-control" />
       </div>


            <button type="submit" class="btn btn-success">
                Save Changes
            </button>

            <a asp-controller="Home" asp-action="Admin" class="btn btn-secondary">
                Cancel
            </a>

        </form>
    </div>
</div>