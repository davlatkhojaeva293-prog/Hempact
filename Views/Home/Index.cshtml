@{
    ViewData["Title"] = "Hempact";
}
<section class="home-hero">
   <div class="hero-content">

    <p class="hero-label">
        HEMP-GROWN • PLASTIC-FREE
    </p>

    <p class="hero-description">
        Soft, breathable and sustainable period care products made with a hemp-based approach.
    </p>

    <div class="hero-buttons">
        <a href="/Home/Subscription" class="hero-primary-btn">
            Create Your Plan →
        </a>

        <a href="/Home/Products" class="hero-secondary-btn">
            Shop Products
        </a>
    </div>



</div>

    </div>
</section>
<section class="benefit-bar">

    <div class="benefit-track">

        <span> Plastic Free</span>
        <span>•</span>

        <span> Biodegradable</span>
        <span>•</span>

        <span> Hemp Based</span>
        <span>•</span>

        <span> Sustainable Care</span>
        <span>•</span>

        <span> Women Designed</span>
        <span>•</span>

        <span> Planet Friendly</span>

    </div>

</section>

<section class="container py-5">

    <div class="row align-items-center">

        <div class="col-lg-6">

            <p class="text-success fw-bold">WHO WE ARE</p>

            <h2 class="brand-serif-title mb-4">Who We Are</h2>

            <p class="mb-4">
                We are two young women entrepreneurs who set out to make one of the most natural parts of a woman’s life visible and to break long-standing taboos. Hempact is not simply a brand for women; it is a social impact movement designed by women, for women.
            </p>

            <p class="mb-4">
                As women ourselves, we started this journey to address real needs, everyday discomforts, and issues that are often overlooked. Inspired by nature, we aim to make comfortable, healthy, and sustainable period care products more accessible.
            </p>

            <p class="fw-semibold">
                Because we believe a world where feminine care products are designed by women is possible.
            </p>

        </div>

        <div class="col-lg-6 text-center">
<img src="~/images/founders.png"
     class="img-fluid rounded-4 shadow"
     alt="Hempact Founders">

        </div>

    </div>

</section>
<section class="py-5" style="background:#f8faf7;">
<div class="container">

    <div class="row align-items-center">

        <div class="col-lg-6">

            <img src="~/images/beinghempactly.jpeg"
                 class="img-fluid rounded-4"
                 alt="Being Hempactly">

        </div>

        <div class="col-lg-6">

            <p class="text-success fw-bold">
                BEING HEMPACTLY
            </p>

            <h2 class="brand-serif-title mb-4">
    Being Hempactly
</h2>

            <p class="mb-4">
                We are not afraid to talk about periods, because we know they are not a taboo — they are a source of strength.
            </p>

            <p class="mb-4">
                Being Hempactly means living in harmony with nature’s cycles, embracing solidarity, speaking openly, supporting one another, and choosing to be part of a movement for change.
            </p>

            <p class="mb-4">
                We raise our voices against period poverty and break the silence together. Every product touches a woman, a story, and a future.
            </p>

            <p class="fw-semibold">
                Because transformation starts with us, and every cycle is a new beginning.
            </p>

        </div>

    </div>

</div>
</section>
<section class="py-5">
<div class="container">

    <div class="row align-items-center">

        <div class="col-lg-6 order-lg-2">

            <img src="~/images/hemp.jpg"
                 class="img-fluid rounded-4"
                 alt="Why Hemp">

        </div>

        <div class="col-lg-6 order-lg-1">

            <p class="text-success fw-bold">
                WHY HEMP?
            </p>

           <h2 class="brand-serif-title mb-4">
    Why Hemp?
</h2>

            <p class="mb-4">
                Because transforming taboos requires courage — and we found that courage in hemp.
            </p>

            <p class="mb-4">
                For years, hemp has been misunderstood and surrounded by prejudice. Yet it is one of nature’s most powerful and sustainable resources.
            </p>

            <p class="mb-4">
                Thanks to its antibacterial, antifungal and breathable properties, hemp provides skin-friendly protection and offers a healthier, more sustainable period care experience.
            </p>

            <p class="mb-4">
                For us, hemp is more than a material. It represents the transformation of a taboo. We are redefining hemp: not controversial, but natural; not forbidden, but beneficial.
            </p>

            <p class="fw-semibold">
                Because true sustainability begins not only with products, but with perspective.
            </p>

        </div>

    </div>

</div>
</section>




<section class="container py-5">
    <div class="row text-center">
        <div class="col-md-4 mb-4">
